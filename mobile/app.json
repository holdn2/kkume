{
  "expo": {
    "name": "꾸메",
    "slug": "kkume",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kkume",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.holdn2.kkume",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "일어난 직후 꿈을 녹음해 남기려고 마이크를 써요."
      },
      "appleTeamId": "3PW3FZG3GR"
    },
    "android": {
      "package": "com.holdn2.kkume",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "RecordBoth",
              "displayName": "꿈 기록",
              "description": "말하기 · 적기 두 곳으로 바로 들어가요",
              "supportedFamilies": [
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": true
            }
          ]
        }
      ],
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "꿈 만화를 사진 보관함에 저장하려고 사진 접근을 써요.",
          "savePhotosPermission": "꿈 만화를 사진 보관함에 저장해요.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.93992852944-ke866ebu7f54crioh585333u13cahc0a"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "녹음하는 동안 꿈을 글로 받아써 두려고 음성 인식을 써요. 받아쓰기는 폰 안에서 해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15c9a3a6-60ae-4a44-9dfd-801be469857e"
      },
      "googleWebClientId": "93992852944-9a2lqaidmev14r5jj93pj8e4btdf8qrh.apps.googleusercontent.com",
      "googleIosClientId": "93992852944-ke866ebu7f54crioh585333u13cahc0a.apps.googleusercontent.com"
    },
    "updates": {
      "url": "https://u.expo.dev/15c9a3a6-60ae-4a44-9dfd-801be469857e"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}

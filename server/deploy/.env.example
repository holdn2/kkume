# 배포 설정. 이 파일을 같은 폴더에 .env 로 복사해서 값을 채운다.
# .env 는 .gitignore에 걸려 있어 커밋되지 않는다.

# AWS 리전. 무료 플랜 계정은 ap-southeast-2(시드니)에 묶여 있다.
# 다른 리전은 조직 SCP가 읽기까지 막는다 — README의 "리전" 절 참조.
AWS_REGION=ap-southeast-2

# ECR 리포지터리 이름
ECR_REPO=kkume-server

# AWS 계정 번호 12자리. aws sts get-caller-identity 로 확인한다
AWS_ACCOUNT_ID=

# EC2 퍼블릭 주소. 인스턴스를 만든 뒤 채운다
EC2_HOST=

# EC2 접속 사용자. Amazon Linux 2023 는 ec2-user
EC2_USER=ec2-user

# SSH 키 파일 경로. 키페어를 만들 때 받은 .pem
SSH_KEY=~/.ssh/kkume-deploy.pem

# 컨테이너가 호스트에서 열 포트. 컨테이너 안은 8080 고정
HOST_PORT=80

# EC2 안 Postgres 컨테이너(ec2-db.sh, README 5-1). 앱과 같은 docker 네트워크 kkume-net 의 컨테이너 이름이다
DB_HOST=kkume-db
DB_NAME=kkume
DB_USER=kkume

# 비밀번호는 .env 에만 둔다. 이 예시 파일에는 절대 적지 않는다.
# 바꾸려면 kkume-db 안에서 ALTER ROLE 로 바꾸고 여기를 고친 뒤 재배포한다(README 5-1).
DB_PASSWORD=

# 서버가 발급하는 로그인 토큰의 서명 키.  openssl rand -hex 32
#
# 바꾸면 이미 발급된 토큰이 전부 무효가 되어 모든 사용자가 로그아웃된다.
# 한 번 정하면 계속 쓴다. 비워 두면 서버가 기동할 때마다 임시 키를 만들어
# 배포할 때마다 로그인이 풀리므로, deploy.sh 가 비어 있으면 멈춘다.
JWT_SECRET=

# 오디오 원본을 두는 S3 버킷(시드니). 비어 있으면 deploy.sh 가 멈춘다
AUDIO_BUCKET=

# HTTPS 입구 이름(https.sh 와 deploy.sh 의 바깥 확인). 비워 두면 <EC2_HOST>.nip.io 를 쓴다
HTTPS_HOST=

# 신고 알림 SNS 주제(문서 072). 비어 있으면 deploy.sh 가 멈춘다 — 신고가 와도 운영자가 모르게 되므로
REPORT_TOPIC_ARN=

# 애플 계정 삭제 때 애플 토큰 회수(App Store 5.1.1(v), 문서 076). 비어도 배포는 된다 — 애플 로그인은 되고 회수만 건너뛴다.
# Apple Developer → Keys 에서 만든 Sign in with Apple 키. ID 는 10자, 파일은 이 PC 의 .p8 경로(내용을 여기 옮기지 않는다)
APPLE_KEY_ID=
APPLE_KEY_FILE=

# 꿈 만화 — Cloudflare Workers AI 무료 플랜(문서 081 · 083). 비어도 배포는 된다 — 만화 만들기만 503 comic_unavailable.
# 이 PC 의 키 파일 경로(ACCOUNT_ID=… · API_TOKEN=… 두 줄). 내용을 여기 옮기지 않는다. 토큰 권한은 Workers AI 만
CLOUDFLARE_KEY_FILE=

# DB 백업 보관 일수(README 5-5). 비우면 1 — 처리방침의 "자동 백업 1일". 늘리려면 처리방침부터 고친다
BACKUP_KEEP_DAYS=
